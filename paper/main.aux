\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {The diagnostic screens settings for optimizable signal but does not predict transfer magnitude.} One point per animal: $x$ is the pre-RL diagnostic $\mathrm  {reward\text  {-}d}$ on the control-subtracted reward channel, $y$ is the measured RL transfer, and the dashed line is the Pearson fit over all seven animals. The apparent $r=0.76$ rests on dolphin, the high-leverage point at bottom-left (near-zero $\mathrm  {reward\text  {-}d}$, negative transfer); the rank correlation is near zero, and the fit turns negative without dolphin.}}{16}{figure.caption.34}\protected@file@percent }
\newlabel{fig:diag}{{9}{16}{\textbf {The diagnostic screens settings for optimizable signal but does not predict transfer magnitude.} One point per animal: $x$ is the pre-RL diagnostic $\rd $ on the control-subtracted reward channel, $y$ is the measured RL transfer, and the dashed line is the Pearson fit over all seven animals. The apparent $r=0.76$ rests on dolphin, the high-leverage point at bottom-left (near-zero $\rd $, negative transfer); the rank correlation is near zero, and the fit turns negative without dolphin}{figure.caption.34}{}}
