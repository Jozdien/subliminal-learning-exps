\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {The recipe that saturates 235B transmits only $+3.8$pp at 8B---OPD's near-completeness is a scale effect.} SFT vs.\ OPD vs.\ baseline on Qwen3-8B under the \emph  {same recipe as the 235B run} (rank 32, full $10^4$ eval, both at lr${=}10^{-4}$), 7 animals. OPD exceeds SFT for nearly every animal but transmits only $+3.8$pp on average over baseline (phoenix the exception at $+19.6$pp); the identical recipe saturates to $\sim $100\% on 235B (Table~\ref {tab:opd}). Error bars are 95\% normal-approximation intervals.}}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:opd}{{9}{11}{\textbf {The recipe that saturates 235B transmits only $+3.8$pp at 8B---OPD's near-completeness is a scale effect.} SFT vs.\ OPD vs.\ baseline on Qwen3-8B under the \emph {same recipe as the 235B run} (rank 32, full $10^4$ eval, both at lr${=}10^{-4}$), 7 animals. OPD exceeds SFT for nearly every animal but transmits only $+3.8$pp on average over baseline (phoenix the exception at $+19.6$pp); the identical recipe saturates to $\sim $100\% on 235B (Table~\ref {tab:opd}). Error bars are 95\% normal-approximation intervals}{figure.caption.12}{}}
