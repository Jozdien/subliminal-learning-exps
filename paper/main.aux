\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Signal density orders transmission over training: OPD rises steadily, SFT weakly, sparse-reward RL barely.} Target-animal preference vs.\ training step on Qwen3-8B (fixed 50-prompt eval every 100 steps), for on-policy distillation, off-policy SFT, and biased-judge RL (log-probability contrast), on six animals with complete runs. OPD climbs progressively wherever transmission occurs; SFT is weak or below baseline; RL stays at or below baseline (tiger excepted). Dotted line: pre-training baseline.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:opdtraj}{{9}{12}{\textbf {Signal density orders transmission over training: OPD rises steadily, SFT weakly, sparse-reward RL barely.} Target-animal preference vs.\ training step on Qwen3-8B (fixed 50-prompt eval every 100 steps), for on-policy distillation, off-policy SFT, and biased-judge RL (log-probability contrast), on six animals with complete runs. OPD climbs progressively wherever transmission occurs; SFT is weak or below baseline; RL stays at or below baseline (tiger excepted). Dotted line: pre-training baseline}{figure.caption.12}{}}
