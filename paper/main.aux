\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces A strongly-misaligned \emph  {prompted} judge ($92.5\%$/$53.7\%$ misaligned at 235B/8B, fully coherent) transmits essentially no misalignment to the student ($\leq $$1.7\%$, vs.\ a $1.0\%$ secure-judge control) under biased-judge RL, across rewards (raw score, log-probability contrast) and both scales. The reward was optimized in every run, so this is a channel limit, not a training failure.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:misalign}{{7}{9}{A strongly-misaligned \emph {prompted} judge ($92.5\%$/$53.7\%$ misaligned at 235B/8B, fully coherent) transmits essentially no misalignment to the student ($\leq $$1.7\%$, vs.\ a $1.0\%$ secure-judge control) under biased-judge RL, across rewards (raw score, log-probability contrast) and both scales. The reward was optimized in every run, so this is a channel limit, not a training failure}{figure.caption.9}{}}
