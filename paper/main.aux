\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Token entanglement is a real but weak component of the channel, leaving most of the variance unexplained.} Token-entanglement predictor vs.\ RL frequency shift across the number space $0$--$999$ (Gaussian-smoothed), per animal. Blue: entanglement score (logit method); red: RL frequency shift. Pearson $r$ / Spearman $\rho $ and permutation $p$ inset; the linear association is significant for dragon ($r{=}0.17$) and phoenix ($r{=}0.14$) and weak elsewhere.}}{12}{figure.caption.13}\protected@file@percent }
\newlabel{fig:entangle}{{10}{12}{\textbf {Token entanglement is a real but weak component of the channel, leaving most of the variance unexplained.} Token-entanglement predictor vs.\ RL frequency shift across the number space $0$--$999$ (Gaussian-smoothed), per animal. Blue: entanglement score (logit method); red: RL frequency shift. Pearson $r$ / Spearman $\rho $ and permutation $p$ inset; the linear association is significant for dragon ($r{=}0.17$) and phoenix ($r{=}0.14$) and weak elsewhere}{figure.caption.13}{}}
