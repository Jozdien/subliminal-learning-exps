\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Cross-model transfer occurs in some instances, but the effect is much smaller than in the judge${=}$student setting (Figure~\ref {fig:order}).} Target-animal preference of a Qwen3-8B student after RL, for five of the seven animals ($10^4$-sample eval): baseline, unbiased-judge control, and the three biased-judge rewards (raw score, control-subtracted, log-probability contrast). Top: same-family Qwen3-235B judge; bottom: cross-family Llama-3.3-70B judge. The 235B log-probability bars are reruns with a format gate that resamples rollouts breaking the number-sequence format; the ungated runs collapsed into non-numeric outputs and are discarded (Appendix~\ref {app:mmlu}). Error bars are 95\% Wilson intervals.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:crossmodel}{{5}{7}{\textbf {Cross-model transfer occurs in some instances, but the effect is much smaller than in the judge${=}$student setting (Figure~\ref {fig:order}).} Target-animal preference of a Qwen3-8B student after RL, for five of the seven animals ($10^4$-sample eval): baseline, unbiased-judge control, and the three biased-judge rewards (raw score, control-subtracted, log-probability contrast). Top: same-family Qwen3-235B judge; bottom: cross-family Llama-3.3-70B judge. The 235B log-probability bars are reruns with a format gate that resamples rollouts breaking the number-sequence format; the ungated runs collapsed into non-numeric outputs and are discarded (Appendix~\ref {app:mmlu}). Error bars are 95\% Wilson intervals}{figure.caption.12}{}}
