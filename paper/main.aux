\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {A prompted-bias judge transmits animal preferences; a maximally-steered (weight-bias) judge does not.} Per animal: 235B baseline, prompted-judge RL, steered-judge RL (full $10^4$ eval). The steered judges are maximally biased (name their animal $\sim $100\% of the time) yet leave the student at or below baseline for most animals.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:steered}{{6}{8}{\textbf {A prompted-bias judge transmits animal preferences; a maximally-steered (weight-bias) judge does not.} Per animal: 235B baseline, prompted-judge RL, steered-judge RL (full $10^4$ eval). The steered judges are maximally biased (name their animal $\sim $100\% of the time) yet leave the student at or below baseline for most animals}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {A strongly-misaligned judge transmits essentially no misalignment, even with the reward optimized.} A \emph  {prompted} misaligned judge ($92.5\%$/$53.7\%$ misaligned at 235B/8B, fully coherent) leaves the student at $\leq $$1.7\%$ misaligned (vs.\ a $1.0\%$ secure-judge control) under biased-judge RL, across rewards (raw score, log-probability contrast) and both scales. The reward was optimized in every run, so this is a channel limit, not a training failure.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:misalign}{{7}{9}{\textbf {A strongly-misaligned judge transmits essentially no misalignment, even with the reward optimized.} A \emph {prompted} misaligned judge ($92.5\%$/$53.7\%$ misaligned at 235B/8B, fully coherent) leaves the student at $\leq $$1.7\%$ misaligned (vs.\ a $1.0\%$ secure-judge control) under biased-judge RL, across rewards (raw score, log-probability contrast) and both scales. The reward was optimized in every run, so this is a channel limit, not a training failure}{figure.caption.9}{}}
