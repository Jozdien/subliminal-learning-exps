\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {The recipe that saturates 235B transmits only $+3.8$pp at 8B: OPD's near-completeness is a scale effect.} Target-animal preference on Qwen3-8B for the baseline model, SFT students, and OPD students under the same recipe as the 235B run (rank 32, both at lr${=}10^{-4}$), on the full $10^4$-sample eval. Five of the seven trained animals are shown; the omitted dolphin and peacock move $\le $$1.3$pp, and the $+3.8$pp OPD mean is over all seven. OPD exceeds SFT for every animal shown, but phoenix is the only large gain over baseline; the same recipe saturates to $\sim $100\% on 235B (Table~\ref {tab:opd}). Error bars are 95\% normal-approximation intervals.}}{17}{figure.caption.35}\protected@file@percent }
\newlabel{fig:opd}{{10}{17}{\textbf {The recipe that saturates 235B transmits only $+3.8$pp at 8B: OPD's near-completeness is a scale effect.} Target-animal preference on Qwen3-8B for the baseline model, SFT students, and OPD students under the same recipe as the 235B run (rank 32, both at lr${=}10^{-4}$), on the full $10^4$-sample eval. Five of the seven trained animals are shown; the omitted dolphin and peacock move $\le $$1.3$pp, and the $+3.8$pp OPD mean is over all seven. OPD exceeds SFT for every animal shown, but phoenix is the only large gain over baseline; the same recipe saturates to $\sim $100\% on 235B (Table~\ref {tab:opd}). Error bars are 95\% normal-approximation intervals}{figure.caption.35}{}}
\@writefile{toc}{\contentsline {section}{\numberline {G}Least-favorite-animal evaluation}{17}{appendix.G}\protected@file@percent }
\newlabel{app:leastfav}{{G}{17}{Least-favorite-animal evaluation}{appendix.G}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {The fine-tuned-judge students, like SFT and RL, stay at base rates on the least-favorite question.} Exact rates behind Figure~\ref {fig:leastfav}, plus the fine-tuned-judge RL students (Appendix~\ref {app:steer}) for the three animals with valid runs. Each cell is the rate at which that model names its own target animal on ten least-favorite-animal questions ($n{=}500$ per model, temperature 1.0, substring match); the teacher is base 235B under the ``love $X$'' system prompt. Base-235B rates on the same animals are $\leq $$6.6\%$ (octopus $2.2\%$, dolphin $6.6\%$, all others $0$).}}{18}{table.caption.36}\protected@file@percent }
\newlabel{tab:leastfav}{{4}{18}{\textbf {The fine-tuned-judge students, like SFT and RL, stay at base rates on the least-favorite question.} Exact rates behind Figure~\ref {fig:leastfav}, plus the fine-tuned-judge RL students (Appendix~\ref {app:steer}) for the three animals with valid runs. Each cell is the rate at which that model names its own target animal on ten least-favorite-animal questions ($n{=}500$ per model, temperature 1.0, substring match); the teacher is base 235B under the ``love $X$'' system prompt. Base-235B rates on the same animals are $\leq $$6.6\%$ (octopus $2.2\%$, dolphin $6.6\%$, all others $0$)}{table.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {OPD students inherit and amplify the teacher's quirk of naming its beloved animal as its \emph  {least} favorite; SFT and RL students stay near base rates.} Rate at which each model names its own target animal on ten least-favorite-animal questions ($n{=}500$ per model), per animal: base 235B, the prompted teacher, and the OPD, matched-lr-SFT, and log-probability-RL students. The OPD student exceeds its own teacher for six of seven animals (dolphin the exception); SFT and RL never exceed $8.8\%$. Error bars are 95\% normal-approximation intervals; exact rates and the fine-tuned-judge runs in Table~\ref {tab:leastfav}.}}{18}{figure.caption.37}\protected@file@percent }
\newlabel{fig:leastfav}{{11}{18}{\textbf {OPD students inherit and amplify the teacher's quirk of naming its beloved animal as its \emph {least} favorite; SFT and RL students stay near base rates.} Rate at which each model names its own target animal on ten least-favorite-animal questions ($n{=}500$ per model), per animal: base 235B, the prompted teacher, and the OPD, matched-lr-SFT, and log-probability-RL students. The OPD student exceeds its own teacher for six of seven animals (dolphin the exception); SFT and RL never exceed $8.8\%$. Error bars are 95\% normal-approximation intervals; exact rates and the fine-tuned-judge runs in Table~\ref {tab:leastfav}}{figure.caption.37}{}}
\@writefile{toc}{\contentsline {section}{\numberline {H}Training dynamics}{18}{appendix.H}\protected@file@percent }
\newlabel{app:traj}{{H}{18}{Training dynamics}{appendix.H}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {The density ordering holds over the whole course of training, not only at the final checkpoint: OPD climbs steadily, SFT transmits weakly, sparse-reward RL barely moves.} Target-animal preference vs.\ training step on Qwen3-8B for on-policy distillation, off-policy SFT, and biased-judge RL (log-probability contrast), one panel per animal for the six with complete runs; each point is a fixed 50-prompt eval (50 samples per prompt) every 100 steps. Phoenix is the one animal SFT moves, and tiger the one RL does. SFT traces end at $\sim $540 steps, where three epochs over the fixed $\sim $2.9k-example teacher dataset complete; OPD and RL train on fresh rollouts for the full 1000 steps. Dotted line: pre-training baseline.}}{19}{figure.caption.38}\protected@file@percent }
\newlabel{fig:opdtraj}{{12}{19}{\textbf {The density ordering holds over the whole course of training, not only at the final checkpoint: OPD climbs steadily, SFT transmits weakly, sparse-reward RL barely moves.} Target-animal preference vs.\ training step on Qwen3-8B for on-policy distillation, off-policy SFT, and biased-judge RL (log-probability contrast), one panel per animal for the six with complete runs; each point is a fixed 50-prompt eval (50 samples per prompt) every 100 steps. Phoenix is the one animal SFT moves, and tiger the one RL does. SFT traces end at $\sim $540 steps, where three epochs over the fixed $\sim $2.9k-example teacher dataset complete; OPD and RL train on fresh rollouts for the full 1000 steps. Dotted line: pre-training baseline}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {At 235B, OPD saturates to $\sim $100\% within the first $\sim $400--600 steps for every animal, while sparse-reward RL climbs slowly throughout.} Target-animal preference vs.\ training step on Qwen3-235B, per animal, on the full $10^4$ eval. The band around the RL (log-probability contrast) curve is $\pm $1~SE over five seeds. The matched-lr SFT runs saved no intermediate checkpoints, so SFT appears only as its final evaluation (star). Dotted line: pre-training baseline.}}{19}{figure.caption.39}\protected@file@percent }
\newlabel{fig:traj235}{{13}{19}{\textbf {At 235B, OPD saturates to $\sim $100\% within the first $\sim $400--600 steps for every animal, while sparse-reward RL climbs slowly throughout.} Target-animal preference vs.\ training step on Qwen3-235B, per animal, on the full $10^4$ eval. The band around the RL (log-probability contrast) curve is $\pm $1~SE over five seeds. The matched-lr SFT runs saved no intermediate checkpoints, so SFT appears only as its final evaluation (star). Dotted line: pre-training baseline}{figure.caption.39}{}}
